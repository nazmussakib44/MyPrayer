{
  "expo": {
    "name": "MyPrayer",
    "slug": "MyPrayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.MyPrayer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to provide accurate prayer times for your city.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses your location to provide accurate prayer time notifications even when the app is not in use.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "entitlements": {
        "com.apple.developer.aps-environment": "development"
      },
      "jsEngine": "hermes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.MyPrayer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
      ],
      "jsEngine": "hermes"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for accurate prayer time notifications."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f8f8"
        }
      ]
    ]
  }
}